# ==============================================================================
# CHARGEATLAS INDIA — ENVIRONMENT CONFIGURATION TEMPLATE
# Competition: IIT Bombay Techfest 2026-27 | EV Infrastructure Map India Challenge
# ==============================================================================
# Copy this template to .env and configure appropriate values for your deployment tier.
# NEVER commit the active .env file containing real database credentials or secrets.

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="ChargeAtlas India"
# Application environment: 'development', 'testing', or 'production'
# In 'production', PostgreSQL with PostGIS is MANDATORY; SQLite fallback is prohibited.
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Cryptographic secret key for RFC 7519 HMAC-SHA256 JWT signing
# Generate in production using: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-64-character-hex-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Internal administrative API key for automated maintenance and data ingestion pipelines
ADMIN_API_KEY="replace-with-a-secure-admin-api-key-in-production"

# Allowed CORS origins for frontend integration (comma-separated, no trailing slashes)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80"

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 18 + PostGIS / SQLite Development)
# ------------------------------------------------------------------------------
# Engine mode options:
# - 'auto': Checks PostgreSQL first; falls back to SQLite only in development/testing.
# - 'postgres': Forces PostgreSQL (required in production).
# - 'sqlite': Forces local SQLite development database.
DB_ENGINE_MODE="auto"

DB_HOST="localhost"
DB_PORT=5432
DB_NAME="chargeatlas_db"
DB_USER="postgres"
DB_PASSWORD="your-strong-production-database-password-here"

# ------------------------------------------------------------------------------
# 4. DATA MODE & QUALITY GOVERNANCE
# ------------------------------------------------------------------------------
# SYNTHETIC_DATA_MODE:
# - false (Default): Authentic Production Mode. Analytical views strictly reflect
#   verified government records (VAHAN 4, BEE EV Yatra, Census 2011, MSRDC).
# - true: Demonstration mode with synthetic scenario data isolated and watermarked.
SYNTHETIC_DATA_MODE=false

# ------------------------------------------------------------------------------
# 5. UPLOAD & SECURITY RESTRICTIONS
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (15,728,640 bytes = 15 MB)
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_UPLOAD_EXTENSIONS=".csv,.xlsx,.xls,.geojson,.json"

# Rate limiting
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=180

