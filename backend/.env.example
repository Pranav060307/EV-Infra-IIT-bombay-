# ==============================================================================
# ChargeAtlas India — Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="ChargeAtlas India"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# CORS Configuration (Frontend Origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# PostgreSQL + PostGIS Spatial Database Configuration
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="chargeatlas_db"
DB_USER="postgres"
DB_PASSWORD="your_password_here"

# Database Engine Override (Set to 'sqlite' for in-memory / zero-config local testing)
DB_ENGINE_MODE="auto" # Options: 'auto' (tries postgres then sqlite fallback), 'postgres', 'sqlite'

# Data Mode
SYNTHETIC_DATA_MODE=true # Flags that initial data is demonstration mock data

